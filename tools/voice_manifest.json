{
  "sample_rate": 21024,
  "song_id_base": 601,
  "notes": [
    "duelist: AI_DUELIST_* (include/ai.h) or DUELIST_* (include/overworld.h); use a JSON array for multiple story duelist IDs that share one clip. Raw int = vanilla voice id (opponent ANY); used for Serenity who has no story duel ID.",
    "DUELIST_STRINGS_070 is Galapagos Strings (alias of mislabeled DUELIST_MAKO_070).",
    "card_id uses CARD_* defines from include/constants/card_ids.h.",
    "trigger: turn_start | attack_card | opponent_lp_below (alternate turn_start when opponent LP < lp_threshold).",
    "replace_vanilla: when true, skip the vanilla clip for the same trigger type.",
    "gain_db: optional per-clip loudness boost/cut in dB before peak normalization.",
    "turn_text: optional duel textbox line on opponent turn (turn_start / opponent_lp_below only).",
    "trim_silence: optional per-clip or manifest default; strips leading/trailing near-silence before DPCM (default true).",
    "trim_silence_threshold: |s8| sample magnitude treated as silence at edges (default 8).",
    "WAV files live under src_custom/assets/voices/ (mono or stereo; resampled at build)."
  ],
